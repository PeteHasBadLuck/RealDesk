# Copy to .env and replace every placeholder with strong unique values.
POSTGRES_DB=realdesk
POSTGRES_USER=realdesk
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
VOIP_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RECORDING_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080

# Optional: on first startup, create an initial OWNER account.
# Use a unique email and a password of at least 14 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD
SEED_COMPANY_NAME=Your Company